source_up
strict_env
set -a

# Credentials live in Bitwarden. Unlock first: export BW_SESSION="$(bw unlock --raw)"
# `bw get` substring-matches item names, so no item name may contain another one
# (hence token-secret / key-secret rather than token / key).
CLOUDFLARE_ACCOUNT_ID="$(bw get password "homelab/production/cloudflare/account-id")"
CLOUDFLARE_API_TOKEN_ID="$(bw get password "homelab/production/cloudflare/token-id")"
CLOUDFLARE_API_TOKEN="$(bw get password "homelab/production/cloudflare/token-secret")"
# Cloudflare R2, compatible with S3 hence the AWS prefix

AWS_ACCESS_KEY_ID="$CLOUDFLARE_API_TOKEN_ID"
AWS_SECRET_ACCESS_KEY="$(printf '%s' "$CLOUDFLARE_API_TOKEN" | sha256sum | cut -d ' ' -f1)"

B2_APPLICATION_KEY_ID="$(bw get password "homelab/production/backblaze/key-id")"
B2_APPLICATION_KEY="$(bw get password "homelab/production/backblaze/key-secret")"

set +a
